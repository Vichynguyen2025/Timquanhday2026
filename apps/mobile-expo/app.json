{
  "expo": {
    "name": "TimQuanhDay",
    "slug": "timquanhday",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2563EB"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.timquanhday.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2563EB"
      },
      "package": "com.timquanhday.app"
    },
    "plugins": [
      "expo-image-picker",
      "expo-location"
    ],
    "runtimeVersion": "exposdk:54.0.0"
  }
}